# Chipnet test wallets only. Never put a mainnet phrase here.
# Generate all with: npm run wallets -- generate   (writes .env with mode 0600, prints addresses only)
# Add a missing one: npm run wallets -- add        (appends, never changes an existing phrase)
MAKER_MNEMONIC=
TAKER_MNEMONIC=
# Landing template only: receives converted tokens or returned BCH. Never spends in the runs.
OWNER_MNEMONIC=
