# Chipnet test wallets. Mainnet phrases only under the MAINNET_ names below.
# Generate all with: npm run wallets -- generate   (writes .env with mode 0600, prints addresses only)
# Add a missing one: npm run wallets -- add        (appends, never changes an existing phrase)
MAKER_MNEMONIC=
TAKER_MNEMONIC=
# Landing template only: receives converted tokens or returned BCH. Never spends in the runs.
OWNER_MNEMONIC=
# One minimum mainnet Landing run (config/mainnet.json): npm run wallets -- add --network mainnet
# New phrases, never the chipnet ones. Payer funds land; owner only receives the returned coins.
MAINNET_PAYER_MNEMONIC=
MAINNET_OWNER_MNEMONIC=
